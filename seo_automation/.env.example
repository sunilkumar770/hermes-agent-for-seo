# GoRentals SEO Automation - Free API Credentials
# Copy this to .env and fill in your values

# ===========================================
# GOOGLE SEARCH CONSOLE (FREE - Required)
# ===========================================
# 1. Google Cloud Console → Create Service Account
# 2. Enable Search Console API
# 3. Download JSON key → save as config/gsc_credentials.json
# 4. Add service account email to GSC property as "Owner"
GSC_CREDENTIALS_PATH=config/gsc_credentials.json
GSC_PROPERTY=sc-domain:gorentals.com

# ===========================================
# SERPBEAR - Self-Hosted Rank Tracker (FREE)
# ===========================================
# Run locally: docker run -d -p 8080:8080 -v serpbear:/app/data serpbear/serpbear
# Or on VPS ($4/mo DigitalOcean)
SERPBEAR_URL=http://localhost:8080
# Optional: Generate API key in SerpBear UI
SERPBEAR_API_KEY=

# ===========================================
# PAGESPEED INSIGHTS (FREE - Optional Key)
# ===========================================
# 25,000 requests/day without key, 200,000 with key
# Google Cloud → Enable PageSpeed Insights API → Create API key
PAGESPEED_KEY=

# ===========================================
# SERPAPI (100 FREE SEARCHES/MONTH)
# ===========================================
# Sign up at https://serpapi.com → Get API key
SERPAPI_KEY=

# ===========================================
# DATAFORSEO (PAY-PER-USE, $5 FREE CREDIT)
# ===========================================
# Sign up at https://dataforseo.com → Get login/password
# $5 free credit = ~5,000 keyword lookups
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ===========================================
# AHREFS WEBMASTER TOOLS (FREE FOR VERIFIED SITES)
# ===========================================
# 1. Verify site in Ahrefs Webmaster Tools
# 2. Get API token from dashboard
AHREFS_WMT_TOKEN=

# ===========================================
# BING WEBMASTER TOOLS (FREE)
# ===========================================
# Bing Webmaster → API Key
BING_WEBMASTER_API_KEY=

# ===========================================
# GITHUB DEPLOYMENT
# ===========================================
GITHUB_TOKEN=
GITHUB_REPO=gorentals/seo-content
GITHUB_BRANCH=seo-automation